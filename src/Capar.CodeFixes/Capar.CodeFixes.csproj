<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The IDE half of the analyzers, in an assembly of its own. Code fixes need Roslyn's Workspaces layer, which
    the IDE has and the command-line compiler does not; kept apart, the compiler never has to load it. The dll
    ships next to the generator under analyzers/ in the Capar package.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
