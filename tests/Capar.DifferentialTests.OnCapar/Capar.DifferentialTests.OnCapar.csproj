<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shared scenarios, compiled against Capar and its generated mediator. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      CPR0001 is the generator reporting the requests that have no handler. The scenarios declare two on
      purpose, to compare what each library does when one is sent.
    -->
    <NoWarn>$(NoWarn);CPR0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Capar" />
    <Using Include="Capar.Pipeline" />
    <Compile Include="../Capar.DifferentialTests.Scenarios/*.cs" LinkBase="Scenarios" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests reach the generated mediator, which is internal, to check the typed overloads directly. -->
    <InternalsVisibleTo Include="Capar.DifferentialTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Capar/Capar.csproj" />
    <ProjectReference Include="../../src/Capar.SourceGenerator/Capar.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
