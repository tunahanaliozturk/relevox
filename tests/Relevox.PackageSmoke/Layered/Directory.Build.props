<Project>
  <!--
    A solution laid out the way the migration trials were: a contracts-only library, an application layer that
    calls AddRelevox, and a host below it. Built from the packages only, like the project one folder up.
  -->
  <PropertyGroup>
    <SmokeFramework Condition="'$(SmokeFramework)' == ''">net10.0</SmokeFramework>
    <TargetFramework>$(SmokeFramework)</TargetFramework>
    <SmokeExtensionsVersion>10.0.0</SmokeExtensionsVersion>
    <SmokeExtensionsVersion Condition="'$(SmokeFramework)' == 'net11.0'">11.0.0</SmokeExtensionsVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)obj/packages</RestorePackagesPath>
    <RelevoxVersion Condition="'$(RelevoxVersion)' == ''">0.0.0-smoke</RelevoxVersion>
  </PropertyGroup>
</Project>
