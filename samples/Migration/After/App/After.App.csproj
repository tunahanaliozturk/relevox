<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!--
    An application would write <PackageReference Include="Capar" />, which brings the generator with it. Inside
    this repository the same thing takes two project references.
  -->
  <ItemGroup>
    <ProjectReference Include="../../../../src/Capar/Capar.csproj" />
    <ProjectReference Include="../../../../src/Capar.SourceGenerator/Capar.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Orders/After.Orders.csproj" />
  </ItemGroup>

</Project>
