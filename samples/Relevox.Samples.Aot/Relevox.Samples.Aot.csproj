<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Published with NativeAOT in CI and run. Warnings are errors here as everywhere, and PublishAot turns on the
    trim and AOT analyzers at build time, so any reflection the generated code or the runtime still needs would
    fail this build before a binary exists. The program then checks its own output and exits non-zero on a
    wrong answer.
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Unions.cs is C# 15 and needs .NET 11's IUnion, so it is compiled for net11.0 alone, with the language turned up
    for that framework only. The net10.0 binary stays C# 14 like the rest of the repository.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <LangVersion>15.0</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <Compile Remove="Unions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Relevox/Relevox.csproj" />
    <ProjectReference Include="../../src/Relevox.SourceGenerator/Relevox.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
