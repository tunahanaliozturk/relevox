<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ScaleCount requests per library (500 unless set), written by generate.py. Handler count is a property of a
    compilation, so this is a separate assembly from the main benchmarks, and each size is its own build:
    ScaleCount=2500 dotnet build -c Release benchmarks/Relevox.Benchmarks.Scale
    Mediator is built with transient handlers here, the same as MediatR's and Relevox's defaults, which the main
    benchmarks cannot do because Mediator reads its lifetime at compile time.

    The committed Generated.cs is the output for 500, so building the solution needs no Python. Any other size
    runs generate.py during the build and compiles its output from the intermediate folder instead. Set
    ScaleCount as an environment variable, not as a global property: BenchmarkDotNet builds the project again in a
    child process, which sees environment variables but not global properties.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RootNamespace>Scale</RootNamespace>
    <ScaleCount Condition="'$(ScaleCount)' == ''">500</ScaleCount>
    <!-- Keyed by size, so building one size does not overwrite another's output. -->
    <IntermediateOutputPath>obj/n$(ScaleCount)/$(Configuration)/</IntermediateOutputPath>
    <OutputPath>bin/n$(ScaleCount)/$(Configuration)/</OutputPath>
    <PythonCommand Condition="'$(PythonCommand)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">python</PythonCommand>
    <PythonCommand Condition="'$(PythonCommand)' == ''">python3</PythonCommand>
  </PropertyGroup>

  <ItemGroup Condition="'$(ScaleCount)' != '500'">
    <Compile Remove="Generated.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Relevox/Relevox.csproj" />
    <ProjectReference Include="../../src/Relevox.SourceGenerator/Relevox.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- IntermediateOutputPath is only final once the SDK has appended the framework, so it is read in the targets. -->
  <Target Name="GenerateScaleMessages" Condition="'$(ScaleCount)' != '500'"
          Inputs="generate.py" Outputs="$(IntermediateOutputPath)Scale$(ScaleCount).cs">
    <Exec Command="$(PythonCommand) generate.py $(ScaleCount) &quot;$(IntermediateOutputPath)Scale$(ScaleCount).cs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="IncludeScaleMessages" Condition="'$(ScaleCount)' != '500'"
          DependsOnTargets="GenerateScaleMessages" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Scale$(ScaleCount).cs" />
      <FileWrites Include="$(IntermediateOutputPath)Scale$(ScaleCount).cs" />
    </ItemGroup>
  </Target>

</Project>
