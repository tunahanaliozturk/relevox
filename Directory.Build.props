<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Tunahan Ali Ozturk</Authors>
    <Product>Relevox</Product>
    <Copyright>Copyright (c) 2026 Tunahan Ali Ozturk</Copyright>
    <RepositoryUrl>https://github.com/tunahanaliozturk/relevox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/tunahanaliozturk/relevox</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <!-- Maps source paths to the repository in CI builds, so SourceLink and deterministic checks pass. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- A package with a page of its own sets this in its project file; items read it after every property. -->
    <RelevoxPackageReadme>$(MSBuildThisFileDirectory)docs/package-readme.md</RelevoxPackageReadme>
    <!-- Checks the package against the rules NuGet applies to a library, such as matching assets per framework. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Compares every public member with the last release, Relevox.Internal included, and fails the pack on a
      breaking change (ADR 0011). Moved forward after each release.
    -->
    <PackageValidationBaselineVersion>1.4.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!--
    Items are evaluated after every property, so this sees IsPackable as each project set it. The package gets
    its own short README: nuget.org does not render the repository README's relative SVG images.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)docs/brand/relevox-icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
    <None Include="$(RelevoxPackageReadme)" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

</Project>
