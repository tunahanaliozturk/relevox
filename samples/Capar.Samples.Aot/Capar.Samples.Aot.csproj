<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Published with NativeAOT in CI and run. Warnings are errors here as everywhere, and PublishAot turns on the
    trim and AOT analyzers at build time, so any reflection the generated code or the runtime still needs would
    fail this build before a binary exists. The program then checks its own output and exits non-zero on a
    wrong answer.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Capar/Capar.csproj" />
    <ProjectReference Include="../../src/Capar.SourceGenerator/Capar.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
