<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capar</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Capar.Contracts</PackageId>
    <Description>Request, notification and handler interfaces for Çapar. No dependencies, so domain and application projects can reference them without pulling in a container or the source generator.</Description>
    <PackageTags>mediator;cqrs;mediatr;contracts</PackageTags>
  </PropertyGroup>

  <!--
    The migration analyzer and its code fix travel with the contracts, because every project with MediatR code
    references them: libraries directly, the application through Capar. Built first, packed under analyzers/,
    never referenced as assemblies.
  -->
  <ItemGroup>
    <ProjectReference Include="../Capar.Migration/Capar.Migration.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Capar.CodeFixes/Capar.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Capar.Migration/bin/$(Configuration)/netstandard2.0/Capar.Migration.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../Capar.CodeFixes/bin/$(Configuration)/netstandard2.0/Capar.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
