<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Relevox</PackageId>
    <Description>A mediator for .NET whose dispatch is written by a source generator at build time, with the same handler signatures as MediatR 12. MIT licensed.</Description>
    <PackageTags>mediator;cqrs;mediatr;source-generator;aot;performance</PackageTags>
    <!-- NuGet warns about any dll outside lib/; the message map task under tasks/ is meant for MSBuild, not the app. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The lowest version Relevox needs, so the package does not push applications onto a newer patch than they chose.
      The rest of the repository builds against the latest.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets none, so the contracts' migration analyzer reaches projects that reference only Relevox. -->
    <ProjectReference Include="../Relevox.Contracts/Relevox.Contracts.csproj" PrivateAssets="none" />
    <!--
      Built before this project so its dll can be packed under analyzers/, but not referenced as an
      assembly: the generator runs inside the consumer's compiler and never at run time.
    -->
    <ProjectReference Include="../Relevox.SourceGenerator/Relevox.SourceGenerator.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The MSBuild task that writes the message map, built before this project and packed beside its targets. -->
    <ProjectReference Include="../Relevox.Build/Relevox.Build.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Relevox.SourceGenerator/bin/$(Configuration)/netstandard2.0/Relevox.SourceGenerator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="../Relevox.Build/bin/$(Configuration)/netstandard2.0/Relevox.Build.dll"
          Pack="true"
          PackagePath="tasks/netstandard2.0"
          Visible="false" />
    <None Include="buildTransitive/*" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

</Project>
