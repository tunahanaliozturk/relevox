<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shared scenarios, compiled against Relevox and its generated mediator. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      RVX0001 is the generator reporting the requests that have no handler. The scenarios declare two on
      purpose, to compare what each library does when one is sent.
    -->
    <NoWarn>$(NoWarn);RVX0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Relevox" />
    <Using Include="Relevox.Pipeline" />
    <Using Include="Relevox.NotificationPublishers" />
    <Compile Include="../Relevox.DifferentialTests.Scenarios/*.cs" LinkBase="Scenarios" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests reach the generated mediator, which is internal, to check the typed overloads directly. -->
    <InternalsVisibleTo Include="Relevox.DifferentialTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Relevox/Relevox.csproj" />
    <ProjectReference Include="../../src/Relevox.SourceGenerator/Relevox.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
