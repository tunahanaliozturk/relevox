<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Runtime">
    <!-- Apache-2.0. Only Relevox.FluentValidation depends on it, at the lowest version it needs. -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Roslyn">
    <!--
      5.0.0 rather than the newest on purpose. A generator runs inside the consumer's compiler, so this is the
      floor of what can load it: 5.0.0 shipped with the first .NET 10 SDK, so every .NET 10 SDK can run it.
      Referencing 5.9 would refuse to load on the earlier 10.0 SDK bands. See ADR 0003.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Build task">
    <!--
      Compile-time references for Relevox.Build. The MSBuild that loads the task supplies its own, newer copies,
      so these only need to be old enough for every host that builds .NET 10. System.Reflection.Metadata is
      also pinned for Roslyn, which needs 9.0.0.
    -->
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.11.0" />
    <PackageVersion Include="System.Reflection.Metadata" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Samples">
    <!--
      OpenTelemetry's own packages (Apache-2.0), used only by the web sample to export over OTLP. Relevox itself
      depends on none of them: it emits through System.Diagnostics, which OpenTelemetry listens to.
    -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup Label="Testing and measurement">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="NJsonSchema" Version="11.6.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup Label="Baselines">
    <!--
      MediatR 12.5.0 is the last Apache-2.0 release; 13 and later are RPL-1.5 or commercial and would fail
      the licence gate. It is the library people are migrating away from, so it is the first baseline and,
      later, the test oracle for behaviour.
    -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <!--
      Mediator (martinothamar/Mediator, MIT) is the other source-generated option. Latest stable rather than
      the 3.1 release candidate, so the comparison is against what people actually ship.
    -->
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
  </ItemGroup>

</Project>
