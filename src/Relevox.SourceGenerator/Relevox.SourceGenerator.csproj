<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Not a choice. Roslyn loads analyzers into the compiler's own process and only supports this. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- netstandard2.0 has no implicit usings worth having, and the generator spells out what it uses. -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Every diagnostic this generator reports, tracked across releases. Roslyn's own analyzer fails the build
      when a rule appears, changes severity or disappears without a note here.
    -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Relevox.SourceGenerator.Tests" />
  </ItemGroup>

</Project>
